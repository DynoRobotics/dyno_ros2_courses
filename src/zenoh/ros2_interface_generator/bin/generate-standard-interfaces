#!/usr/bin/env python3
"""
Quick script to generate standard ROS2 interfaces.

Usage:
    generate-standard-interfaces [preset] [output_path]
    
Presets:
    essential - Core messages only (builtin_interfaces, std_msgs, geometry_msgs, sensor_msgs)
    common    - Essential + common packages (nav_msgs, trajectory_msgs, etc.)
    standard  - Most commonly used ROS2 packages (default)
    all       - All available ROS2 packages
    
Examples:
    generate-standard-interfaces
    generate-standard-interfaces common
    generate-standard-interfaces standard /tmp/my_interfaces
"""

import sys
from pathlib import Path

# Add parent directory to path
sys.path.insert(0, str(Path(__file__).parent.parent))

from ros2_interface_generator import generate

def main():
    preset = 'standard' if len(sys.argv) < 2 else sys.argv[1]
    output_path = 'ros2_interfaces_py' if len(sys.argv) < 3 else sys.argv[2]
    
    # Show help
    if preset in ['-h', '--help', 'help']:
        print(__doc__)
        return
    
    print(f"🚀 Generating {preset} ROS2 interfaces...")
    print(f"   Output: {output_path}")
    print()
    
    try:
        generate(
            language='python',
            preset=preset,
            output_path=output_path
        )
        print()
        print("✅ Done! To install:")
        print(f"   cd {output_path} && pip install -e .")
        
    except Exception as e:
        print(f"❌ Error: {e}")
        sys.exit(1)

if __name__ == '__main__':
    main()

