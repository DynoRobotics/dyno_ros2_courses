{
  "name": "@ros2-zenoh/tools",
  "version": "0.1.0",
  "description": "Documentation and validation tools for ros2-zenoh",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ros2-zenoh-tools": "./dist/cli/validate.js"
  },
  "scripts": {
    "build": "tsc",
